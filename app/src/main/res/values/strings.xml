    <string name="ad_title">SECURITY BENEFITS</string>
    <string name="ad_1">Military standard: AES 256-bit protects your secrets like a bank.</string>
    <string name="ad_2">Self-destructing: Messages delete themselves irrevocably after opening.</string>
    <string name="ad_3">Short links: Remember just 5 digits instead of long URLs.</string>
    <string name="ad_4">Absolute privacy: No trace of your message remains on our servers.</string>
    <string name="ad_5">Secure exchange: AES 256-bit is the gold standard for governments.</string>
    <string name="ad_6">Read once, gone forever: Our messages self-destruct  guaranteed.</string>
    <string name="ad_7">Convenient: Get short, memorable links like domezos-ware.com/12345.</string>
    <string name="ad_8">Encrypted DB: Large parts of the link are securely managed in the background.</string>
    <string name="ad_9">Bank-grade trust: Your data is secured with uncrackable AES 256-bit.</string>
    <string name="ad_10">Maximum discretion: Irrevocable deletion keeps secrets secret.</string>
